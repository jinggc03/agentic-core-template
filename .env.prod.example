# ═══════════════════════════════════════════════════════════════════════════
# .env.prod.example  —  LEGACY FILE, no longer the source of truth
# ═══════════════════════════════════════════════════════════════════════════
#
# This file existed in the previous configuration system (.env.*).
# All non-secret values it contained have been migrated to:
#
#   params/base/params.yml       ← shared defaults
#   params/prod/params.yml       ← production overrides
#
# The only values that should be in an .env file are secrets:
#
#   API_KEY, OPENROUTER_API_KEY, TELEGRAM_BOT_TOKEN, SUPABASE_*, etc.
#
# Copy the secrets template with:
#   cp .env.example .env
#
# This file can be safely deleted.
# ═══════════════════════════════════════════════════════════════════════════


# Production Settings - DO NOT CHANGE
APP_ENV=prod
APP_DEBUG=False
LOG_LEVEL=WARNING
RELOAD=False

# Server
HOST=0.0.0.0
PORT=8000

# LLM Configuration - CRITICAL: Must be set via environment variables
# DO NOT commit real keys to any .env file
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
# OPENROUTER_API_KEY=SET-VIA-ENVIRONMENT-VARIABLES

# Supabase - REQUIRED in production
# SUPABASE_URL=SET-VIA-ENVIRONMENT-VARIABLES
# SUPABASE_ANON_KEY=SET-VIA-ENVIRONMENT-VARIABLES
# SUPABASE_SERVICE_ROLE_KEY=SET-VIA-ENVIRONMENT-VARIABLES
# SUPABASE_DB_URL=SET-VIA-ENVIRONMENT-VARIABLES

# Telegram - Optional but if enabled, token REQUIRED
# TELEGRAM_ENABLED=False
# TELEGRAM_BOT_TOKEN=SET-VIA-ENVIRONMENT-VARIABLES

# Production Features
MCP_ENABLED=True
ENABLE_STRUCTURED_LOGS=True
ENABLE_METRICS=True
ALLOW_AGENT_REGISTRATION=False  # Disable in production

# Security Settings
SECRET_KEY=SET-VIA-ENVIRONMENT-VARIABLES
ALLOWED_HOSTS=localhost,127.0.0.1

# API key — REQUIRED in production when API_KEY_ENABLED=true
API_KEY_ENABLED=true
# API_KEY=SET-VIA-ENVIRONMENT-VARIABLES

# CORS — restrict to your production domain only
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# Telegram allowlist — REQUIRED in production to restrict bot access
# TELEGRAM_ALLOWED_USER_IDS=SET-VIA-ENVIRONMENT-VARIABLES

# Execution Limits (strict prod defaults)
MAX_MODEL_CALLS_PER_TURN=1
MAX_TOOL_CALLS_PER_TURN=5
MAX_AGENT_TURNS=10
MAX_INPUT_CHARS=8000
MAX_OUTPUT_CHARS=12000
AGENT_TIMEOUT_SECONDS=30

# ═══════════════════════════════════════════════════════════════════════════
# .env.example  —  SECRETS ONLY
# ═══════════════════════════════════════════════════════════════════════════
#
# This file is a template for .env (git-ignored).
# Copy it:  cp .env.example .env
#
# PURPOSE: Only private / secret values belong here.
# Non-secret configuration (timeouts, feature flags, log levels, etc.)
# goes in params/{base,dev,pre,prod}/params.yml (versioned in git).
#
# Loading order (lower → higher priority):
#   1. params/base/params.yml
#   2. params/{APP_ENV}/params.yml
#   3. .env                         ← this file (secrets / private overrides)
#   4. System environment variables
#
# NEVER commit real secrets. NEVER put non-secret values here.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Environment selector ───────────────────────────────────────────────────
# Controls which params/{APP_ENV}/params.yml is loaded.
# Valid values: dev | pre | prod
APP_ENV=dev

# ─── LLM provider secrets ────────────────────────────────────────────────
# Set the key for your chosen provider (leave others empty).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# LLM_API_KEY=            # Generic fallback if provider-specific is not set

# ─── API protection ────────────────────────────────────────────────────────
API_KEY=

# ─── Request signing ─────────────────────────────────────────────────────────
SECRET_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ─── Supabase / Database ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# DATABASE_URL=
